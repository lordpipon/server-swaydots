{
    "position": "bottom",
    "height": 26,

    "modules-left": [
        "hostname",
        "custom/ip"
    ],

    "modules-center": [
        "cpu",
        "memory",
        "disk",
        "network",
        "battery",
        "custom/uptime"
    ],

    "modules-right": [
        "pulseaudio",
        "backlight",
        "tray",
        "clock"
    ],

    "hostname": {
        "format": "HOST {}",
        "interval": 60
    },

    "cpu": {
        "format": "CPU {usage}%"
    },

    "memory": {
        "format": "RAM {used:0.1f}G/{total:0.1f}G"
    },

    "disk": {
        "format": "DISK {percentage_used}%",
        "path": "/"
    },

    "network": {
        "format-wifi": "NET ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-ethernet": "NET ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
        "format-disconnected": "NET offline"
    },

    "battery": {
        "format": "BAT {capacity}%"
    },

    "clock": {
        "format": "{:%H:%M}"
    },

    "custom/ip": {
        "exec": "hostname -I | awk '{print $1}'",
        "interval": 10,
        "format": "IP {}"
    },

    "custom/uptime": {
        "exec": "uptime -p | sed 's/up //' ",
        "interval": 60,
        "format": "UP {}"
    }
}


"pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTED",
    "scroll-step": 5
}

"network": {
    "format-wifi": "WIFI {essid} {signalStrength}%",
    "format-ethernet": "LAN {ipaddr}",
    "format-disconnected": "NO WIFI"
}


"backlight": {
    "device": "amdgpu_bl0",
    "format": "󰃠 {percent}%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
}
